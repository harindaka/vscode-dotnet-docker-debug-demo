{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "solution-build",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/solution-build.bat",
            "args": [
              "${workspaceFolder}", // Solution / docker context directory path
              "mcr.microsoft.com/dotnet/sdk:9.0", // SDK image used to do the build
              "solution-build-container" // Name of the build container created from the aforementioned SDK image
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "debugger-build",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/debugger-build.bat",
            "args": [
              "${workspaceFolder}/.vscode/debugger-dockerfile", // Path to the Dockerfile used to build the debugger image
              "${workspaceFolder}/StartupHooks", // StartupHooks project / docker context directory path              
              "debugger-image" // Name of the debugger image
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "docker-debug-app-debugger-run",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/debugger-run.bat",
            "dependsOrder": "sequence",
            "dependsOn": ["solution-build", "debugger-build"],
            "args": [
              "${workspaceFolder}", // Solution / docker context directory path
              "./DockerDebugApp/bin/Debug/net9.0/DockerDebugApp.dll", // Path to entrypoint assembly relative to the solution directory              
              "debugger-image", // Name of the debugger image prepared by installing the debugger and startup hook
              "docker-debug-app-container" // Name of app container created from the aforementioned debugger image
            ],
            "problemMatcher": []
        }
    ]
}
