{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/DockerDebugApp/DockerDebugApp.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "docker-build",
            "type": "shell",
            "command": "docker build -t dockerdebugapp .",
            "options": {
                "cwd": "${workspaceFolder}/DockerDebugApp"
            },
            "problemMatcher": []
        },
        {
            "label": "docker-run",
            "type": "shell",
            "command": "docker run --name dockerdebugapp -d --rm dockerdebugapp",
            "options": {
                "cwd": "${workspaceFolder}/DockerDebugApp"
            },
            "problemMatcher": [],
            "dependsOn": ["docker-build"]
        },
        {
            "label": "docker-stop",
            "type": "shell",
            "command": "docker stop dockerdebugapp || true",
            "presentation": {
              "reveal": "always",
              "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "docker-debug-setup",
            "dependsOrder": "sequence",
            "dependsOn": ["docker-stop","docker-run"],
            "problemMatcher": []
        }
    ]
}
