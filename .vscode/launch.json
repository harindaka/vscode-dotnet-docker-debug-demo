{
    "version": "0.2.0",
    "compounds": [
        {
            "name": "Debug All",
            "configurations": ["Debug ConsoleApp", "Debug UnitTests"]
        }
    ],
    "configurations": [
        {
            "name": "Debug ConsoleApp",
            "type": "coreclr",
            "request": "attach",
            "processName": "dotnet",
            "preLaunchTask": "console-app-debugger-run",            
            "pipeTransport": {
                "pipeProgram": "docker",
                "pipeArgs": ["exec", "-i", "console-app-container"],
                "debuggerPath": "/vsdbg/vsdbg",
                "pipeCwd": "${workspaceFolder}/ConsoleApp",
                "quoteArgs": false
            },
            "sourceFileMap": {
                "/src": "${workspaceFolder}"
            },
            "justMyCode": true,
            "requireExactSource": false
        },
        {
            "name": "Debug UnitTests",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickRemoteProcess}",
            "preLaunchTask": "unit-tests-debugger-run",
            "pipeTransport": {
                "pipeProgram": "docker",
                "pipeArgs": ["exec", "-i", "unit-tests-container"],
                "debuggerPath": "/vsdbg/vsdbg",
                "pipeCwd": "${workspaceFolder}/UnitTests",
                "quoteArgs": false
            },
            "sourceFileMap": {
                "/src": "${workspaceFolder}"
            },
            "justMyCode": true,
            "requireExactSource": false
        }
    ]
}
